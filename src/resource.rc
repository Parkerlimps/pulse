#include "resource.h"

IDI_APP ICON "build\\app.ico"

1 VERSIONINFO
FILEVERSION     2,0,0,0
PRODUCTVERSION  2,0,0,0
FILEOS          0x40004L
FILETYPE        0x1L
{
    BLOCK "StringFileInfo"
    {
        BLOCK "080404b0"
        {
            VALUE "CompanyName",      "PALI"
            VALUE "FileDescription",  "Pulse - local music player"
            VALUE "FileVersion",      "2.0.0.0"
            VALUE "InternalName",     "Pulse"
            VALUE "OriginalFilename", "Pulse.exe"
            VALUE "ProductName",      "Pulse"
            VALUE "ProductVersion",   "2.0.0.0"
        }
    }
    BLOCK "VarFileInfo"
    {
        VALUE "Translation", 0x804, 1200
    }
}
